---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 — Страница не найдена | YARKIN"
  description="Упс, такой страницы нет. Похоже, она переехала или была удалена. Вернитесь на главную — всё важное на месте."
  noindex={true}
>
  <style is:inline>
    /* Специфические стили 404 — скопированы 1:1 из старого 404.html.
       Часть правил уже есть в global.css (card, btn, hero-blob) —
       здесь только то, что уникально для этой страницы. */
    .nf-wrap {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
      text-align: center;
      position: relative;
    }
    .nf-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 560px;
      padding: 56px 44px;
      background: rgba(255, 255, 255, 0.06);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-card);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }
    .nf-code {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: clamp(72px, 18vw, 140px);
      line-height: 1;
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin: 0 0 8px;
    }
    .nf-card .card-title {
      font-size: 24px;
      font-weight: 600;
      margin: 0 0 12px;
    }
    .nf-card .card-text {
      color: var(--text-muted);
      font-size: 17px;
      line-height: 1.6;
      margin: 0 0 32px;
    }
    .card-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    /* Самодостаточность: не зависит от reveal-анимации.
       Перекрываем глобальный скрывающий селектор .card из style.css. */
    .nf-card {
      opacity: 1 !important;
      transform: none !important;
    }
    @media (max-width: 520px) {
      .nf-card { padding: 40px 20px; }
    }
  </style>
  <div class="nf-wrap">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-blob hero-blob--blue"></div>
      <div class="hero-blob hero-blob--purple"></div>
    </div>

    <div class="nf-card card">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 class="card-title">Страница не найдена</h1>
      <p class="card-text">
            Похоже, ссылка устарела или страница переехала.<br>
            Но всё самое важное — на главной.
      </p>
      <div class="card-actions">
        <a href="/" class="btn btn-primary">На главную</a>
      </div>
    </div>
  </div>
</BaseLayout>
