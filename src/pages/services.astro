---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/services/PageHeader.astro';
import Pricing from '../components/services/Pricing.astro';
import Packages from '../components/services/Packages.astro';
import Faq from '../components/services/Faq.astro';

const serviceLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://yarkin-tech.github.io/services/#service",
    "name": "Сборка, ремонт ПК и настройка ИИ",
    "serviceType": "Компьютерная сборка, ремонт и ИИ-интеграция",
    "description": "Прозрачный прайс без скрытых платежей. Инженерный подход, гарантия на работу, сроки 1–3 дня в Московской области.",
    "url": "https://yarkin-tech.github.io/services/",
    "provider": {
        "@type": "LocalBusiness",
        "name": "YARKIN",
        "url": "https://yarkin-tech.github.io/",
        "telephone": "+7 977 331-80-22",
        "email": "yarkin-tech@yandex.ru"
    },
    "areaServed": "Московская область",
    "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Услуги и цены",
        "itemListElement": [
            { "@type": "Offer", "name": "Premium сборка ПК", "priceCurrency": "RUB", "price": "12000", "description": "от 12 000 ₽" },
            { "@type": "Offer", "name": "Диагностика ПК / ноутбука", "priceCurrency": "RUB", "price": "1500", "description": "от 1 500 ₽" },
            { "@type": "Offer", "name": "Ремонт ПК / ноутбука", "priceCurrency": "RUB", "price": "3000", "description": "от 3 000 ₽" },
            { "@type": "Offer", "name": "Восстановление данных", "priceCurrency": "RUB", "price": "15000", "description": "от 15 000 ₽" },
            { "@type": "Offer", "name": "Установка локальных нейросетей", "priceCurrency": "RUB", "price": "10000", "description": "от 10 000 ₽" }
        ]
    }
});
---

<BaseLayout
    title="Сборка и ремонт ПК — прайс и пакеты | YARKIN"
    description="Готовые пакеты сборки и ремонта ПК от 12 000 ₽. Гарантия на работу, сроки 1–3 дня, прозрачный прайс. Оставьте заявку — подберём и соберём под вашу задачу."
    canonical="https://yarkin-tech.github.io/services/"
>
    <script type="application/ld+json" set:html={serviceLd} />

    <PageHeader />
    <Pricing />
    <Packages />
    <Faq />
</BaseLayout>
