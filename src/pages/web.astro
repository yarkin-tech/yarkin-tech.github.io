---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Сайты под ключ: лендинг от 20 000 ₽ | YARKIN"
  description="Премиальный сайт под ключ для мастера или бизнеса: лендинг от 20 000 ₽, абонемент на обновления, запуск за 7 дней. Оставьте заявку — вернёмся с предложением."
  canonical="/web/"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://yarkin-tech.github.io/web/#service",
    "name": "Сайты под ключ",
    "serviceType": "Веб-разработка и сопровождение",
    "description": "Сайт-визитка и лендинг под ключ от 20 000 ₽. Запуск за 7 дней, абонемент на обновления, инженерный подход, работа по Московской области.",
    "url": "https://yarkin-tech.github.io/web/",
    "provider": {
      "@type": "LocalBusiness",
      "name": "YARKIN",
      "url": "https://yarkin-tech.github.io/",
      "telephone": "+7 977 331-80-22",
      "email": "yarkin-tech@yandex.ru"
    },
    "areaServed": "Московская область",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Тарифы на сайты",
      "itemListElement": [
        { "@type": "Offer", "name": "Лендинг «Старт»", "priceCurrency": "RUB", "price": "20000", "description": "от 20 000 ₽" },
        { "@type": "Offer", "name": "Сайт-визитка «Бизнес»", "priceCurrency": "RUB", "price": "25000", "description": "от 25 000 ₽" },
        { "@type": "Offer", "name": "Премиум-сайт «Про»", "priceCurrency": "RUB", "price": "30000", "description": "от 30 000 ₽" }
      ]
    }
  })} />
        <!-- ===== ЗАГОЛОВОК СТРАНИЦЫ ===== -->
        <section class="page-header reveal">
            <h1 class="page-title">Сайты для мастеров и бизнеса</h1>
            <p class="page-subtitle">Сайт-визитка под ключ за 7 дней. Я слежу за обновлениями — вы занимаетесь клиентами.</p>
        </section>

        <!-- ===== ЧТО ВЫ ПОЛУЧИТЕ ===== -->
        <section class="why-us">
            <h2 class="section-title reveal">Что вы получите</h2>
            <div class="why-us-cards">
                <article class="card reveal">
                    <span class="card-icon">🚀</span>
                    <h3 class="card-title">Запуск за 7 дней</h3>
                    <p class="card-text">От заявки до готового сайта — неделя. Дизайн, адаптивность, размещение в интернете.</p>
                </article>
                <article class="card reveal">
                    <span class="card-icon">📱</span>
                    <h3 class="card-title">Выгодно смотрится с телефона</h3>
                    <p class="card-text">Премиальный тёмный дизайн, быстрая загрузка, удобно с любого устройства.</p>
                </article>
                <article class="card reveal">
                    <span class="card-icon">🔄</span>
                    <h3 class="card-title">Всегда актуальный</h3>
                    <p class="card-text">Абонемент на обновления: меняю цены, добавляю кейсы, слежу за работой сайта.</p>
                </article>
            </div>
        </section>

        <!-- ===== ТАРИФЫ ===== -->
        <section class="packages reveal">
            <h2 class="section-title">Тарифы</h2>
            <div class="packages-grid">
                <article class="package-card">
                    <h3 class="package-name">Старт</h3>
                    <div class="package-price">20 000 ₽</div>
                    <p class="package-desc">+3 000 ₽/мес — абонемент на обновления</p>
                    <ul class="package-features">
                        <li>Лендинг 1 страница</li>
                        <li>Адаптивный дизайн</li>
                        <li>Размещение и настройка</li>
                        <li>До 2 правок в месяц</li>
                    </ul>
                    <a href="/contact/" class="btn btn-primary package-btn">Заказать</a>
                </article>

                <article class="package-card popular">
                    <span class="package-badge">Популярный</span>
                    <h3 class="package-name">Бизнес</h3>
                    <div class="package-price">25 000 ₽</div>
                    <p class="package-desc">+5 000 ₽/мес — абонемент на обновления</p>
                    <ul class="package-features">
                        <li>Сайт-визитка 4-5 страниц</li>
                        <li>Премиальный дизайн</li>
                        <li>Размещение и настройка</li>
                        <li>До 5 правок в месяц</li>
                    </ul>
                    <a href="/contact/" class="btn btn-primary package-btn">Заказать</a>
                </article>

                <article class="package-card maximum">
                    <span class="package-badge">Максимум</span>
                    <h3 class="package-name">Про</h3>
                    <div class="package-price">30 000 ₽</div>
                    <p class="package-desc">+8 000 ₽/мес — абонемент на обновления</p>
                    <ul class="package-features">
                        <li>Всё из «Бизнес»</li>
                        <li>Новые секции и страницы</li>
                        <li>SEO-база</li>
                        <li>Приоритетная поддержка</li>
                    </ul>
                    <a href="/contact/" class="btn btn-primary package-btn">Заказать</a>
                </article>

            </div>
            <p class="packages-note">Без абонемента — 30 000 ₽, сайт полностью ваш. Обновления — платно.</p>

            <!-- ===== РАЗОВЫЕ ОБНОВЛЕНИЯ БЕЗ АБОНЕМЕНТА ===== -->
            <div class="web-updates">
                <h3 class="web-updates__title">Разовые обновления без абонемента</h3>
                <ul class="web-updates__list">
                    <li class="web-updates__row">
                        <span class="web-updates__name">Мелкая правка (цены, тексты, фото)</span>
                        <span class="web-updates__price">3 000 ₽</span>
                    </li>
                    <li class="web-updates__row">
                        <span class="web-updates__name">Среднее изменение (новый блок или секция)</span>
                        <span class="web-updates__price">5 000 ₽</span>
                    </li>
                    <li class="web-updates__row">
                        <span class="web-updates__name">Новая страница</span>
                        <span class="web-updates__price">8 000 ₽</span>
                    </li>
                </ul>
                <p class="web-updates__hint">Больше двух обновлений в месяц? Абонемент выгоднее.</p>
            </div>

            <div class="web-cta">
                <a href="/contact/" class="btn btn-primary">Заказать сайт</a>
            </div>
        </section>
</BaseLayout>
