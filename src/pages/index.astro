---
import BaseLayout from '../layouts/BaseLayout.astro';
// Восстановлено из legacy index.html inline <style>: стили секций
// workflow/portfolio/products не входят в css/style.css (см. AUDIT_REPORT.md)
import '../styles/home-sections.css';
import Hero from '../components/home/Hero.astro';
import PcCalculator from '../components/home/PcCalculator.astro';
import WorksSection from '../components/home/WorksSection.astro';
import CurrentWorkSection from '../components/home/CurrentWorkSection.astro';
import StatsSection from '../components/home/StatsSection.astro';
import WhyUs from '../components/home/WhyUs.astro';
import Services from '../components/home/Services.astro';
import HowIWork from '../components/home/HowIWork.astro';
import Portfolio from '../components/home/Portfolio.astro';
import Products from '../components/home/Products.astro';
import WebTeaserSection from '../components/home/WebTeaserSection.astro';
import CtaSection from '../components/home/CtaSection.astro';
---

<BaseLayout
  title="YARKIN — сборка, ремонт и настройка ПК в Чебоксарах и онлайн"
  description="Соберу ПК под ваши задачи с гарантией, отремонтирую ноутбук или телефон, настрою локальный ИИ. Без наценки на железо. Чебоксары и онлайн по всей России."
  canonical="https://yarkin-tech.github.io/"
>
  <Hero />
  <PcCalculator />
  <WorksSection />
  <CurrentWorkSection />
  <StatsSection />
  <WhyUs />
  <Services />
  <HowIWork />
  <Portfolio />
  <Products />
  <WebTeaserSection />
  <CtaSection />
</BaseLayout>
