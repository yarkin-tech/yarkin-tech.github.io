<section class="pricing">
    <div class="pricing-grid reveal">

        <article class="price-block">
            <h2 class="price-block-title">🎯 Экспертиза и подбор</h2>
            <ul class="price-list">
                <li class="price-item">
                    <span class="price-name">Аудит текущей системы</span>
                    <span class="price-value">3 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Подбор конфигурации ПК / ноутбука</span>
                    <span class="price-value">5 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Подбор смартфона / планшета</span>
                    <span class="price-value">3 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Корпоративный подбор (B2B / серверы)</span>
                    <span class="price-value">от 15 000 ₽</span>
                </li>
            </ul>
        </article>

        <article class="price-block">
            <h2 class="price-block-title">🛠️ Сборка и настройка</h2>
            <ul class="price-list">
                <li class="price-item">
                    <span class="price-name">Стандартная инженерная сборка</span>
                    <span class="price-value">6 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Premium сборка (сложные системы)</span>
                    <span class="price-value">от 12 000 ₽</span>
                </li>
            </ul>
        </article>

        <article class="price-block">
            <h2 class="price-block-title">🔧 Ремонт и диагностика</h2>
            <ul class="price-list">
                <li class="price-item">
                    <span class="price-name">Диагностика ПК / ноутбука</span>
                    <span class="price-value">от 1 500 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Ремонт ПК / ноутбука</span>
                    <span class="price-value">от 3 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Ремонт смартфонов и планшетов</span>
                    <span class="price-value">от 4 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Восстановление данных</span>
                    <span class="price-value">от 15 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Серверное обслуживание</span>
                    <span class="price-value">от 10 000 ₽</span>
                </li>
            </ul>
        </article>

        <article class="price-block">
            <h2 class="price-block-title">💻 Софт и оптимизация</h2>
            <ul class="price-list">
                <li class="price-item">
                    <span class="price-name">Инсталляция и настройка ОС</span>
                    <span class="price-value">3 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Профессиональная настройка под задачи</span>
                    <span class="price-value">от 7 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Перенос данных</span>
                    <span class="price-value">5 000 ₽</span>
                </li>
            </ul>
        </article>

        <article class="price-block">
            <h2 class="price-block-title">🤖 Искусственный интеллект</h2>
            <ul class="price-list">
                <li class="price-item">
                    <span class="price-name">Оптимизация железа под ИИ</span>
                    <span class="price-value">8 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Установка локальных нейросетей</span>
                    <span class="price-value">от 10 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Персональный ИИ-ассистент</span>
                    <span class="price-value">от 15 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">ИИ для творческих профессий</span>
                    <span class="price-value">12 000 ₽</span>
                </li>
                <li class="price-item">
                    <span class="price-name">Обучение работе с ИИ (1 на 1)</span>
                    <span class="price-value">5 000 ₽ / 2 часа</span>
                </li>
            </ul>
        </article>

    </div>
</section>
